# Local fictional-data development only. Never use this password in production.
RELAY_DATA_SOURCE=database
POSTGRES_USER=relay
POSTGRES_PASSWORD=relay_local_only
POSTGRES_DB=relay_ops
POSTGRES_PORT=5433
DATABASE_URL=postgresql://relay:relay_local_only@127.0.0.1:5433/relay_ops
# Optional integration tests. This database MUST be dedicated to tests.
TEST_DATABASE_URL=postgresql://relay:relay_local_only@127.0.0.1:5433/relay_ops_test

# Patch 003: execution stays disabled until npm run demo:configure is run locally.
RELAY_ENABLE_DEMO_RUNS=false
RELAY_DEMO_ORIGIN=http://localhost:3000
RELAY_SIMULATOR_URL=http://127.0.0.1:4010
# Generated into ignored .env.local by demo:configure. Never use NEXT_PUBLIC_.
RELAY_SIMULATOR_TOKEN=
